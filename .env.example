# Multi-Tenant School ERP & Linways AMS - Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
# Comma-separated list of allowed browser origins (no wildcard in production)
CORS_ORIGIN=http://localhost:8080
ENABLE_SWAGGER=false

# Database Connection (Supabase PostgreSQL or standard PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security & Authentication
# REQUIRED. At least 32 random characters, e.g. `openssl rand -base64 48`. The API refuses to start without it.
JWT_SECRET=

# Used by docker-compose for the Postgres container
POSTGRES_PASSWORD=
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# Redis Cache & Sessions (Optional in local dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Linways Academic System Configurations
ATTENDANCE_CONDONATION_THRESHOLD=75
OBE_SYLLABUS_DEFAULT_HOURS=40
DEFAULT_ACADEMIC_YEAR=2026-2027

# Storage & Uploads (Local / AWS S3)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_BYTES=10485760
