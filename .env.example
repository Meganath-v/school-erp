# Multi-Tenant School ERP & Linways AMS - Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database Connection (Supabase PostgreSQL or standard PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# Redis Cache & Sessions (Optional in local dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Linways Academic System Configurations
ATTENDANCE_CONDONATION_THRESHOLD=75
OBE_SYLLABUS_DEFAULT_HOURS=40
DEFAULT_ACADEMIC_YEAR=2026-2027

# Storage & Uploads (Local / AWS S3)
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_BYTES=10485760
