datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  // One SQL query per include tree instead of one round trip per relation level
  // (the database is ~200 ms away, so nested includes were the main latency cost).
  previewFeatures = ["relationJoins"]
}

// ----------------------------------------------------
// 1. TENANT & SUBSCRIPTION
// ----------------------------------------------------

model School {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  slug         String   @unique
  status       String   @default("ACTIVE") // PENDING, TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED, CLOSED
  timezone     String   @default("Asia/Kolkata")
  locale       String   @default("en_IN")
  currency     String   @default("INR")
  logoUrl      String?
  address      String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains             SchoolDomain[]
  subscriptions       Subscription[]
  memberships         UserSchoolMembership[]
  campuses            Campus[]
  academicYears       AcademicYear[]
  academicTerms       AcademicTerm[]
  classes             Class[]
  sections            Section[]
  students            Student[]
  guardians           Guardian[]
  staff               Staff[]
  subjects            Subject[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions  AttendanceSession[]
  timetableEntries    TimetableEntry[]
  assignments         Assignment[]
  exams               Exam[]
  feeHeads            FeeHead[]
  feePlans            FeePlan[]
  invoices            Invoice[]
  payments            Payment[]
  leaveRequests       LeaveRequest[]
  announcements       Announcement[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  reminders           Reminder[]
  tasks               Task[]
  feedbacks           Feedback[]
  circulars           Circular[]
  lessonPlans         LessonPlan[]
  teachingDiaries     TeachingDiaryEntry[]
  courseMaterials     CourseMaterial[]
  courseOutcomes      CourseOutcome[]
  studentDocuments    StudentDocument[]
  programs            Program[]
  programOutcomes     ProgramOutcome[]
  questions           Question[]
  questionPapers      QuestionPaper[]
  attainmentRules     AttainmentRule[]
  internalSchemes     InternalMarkScheme[]
  quizzes             Quiz[]
  notificationLogs    NotificationDeliveryLog[]
  aiExamTests        AiExamTest[]
  aiExamSettings     AiExamSettings?
  aiExamPlans        AiExamImprovementPlan[]

  timetablePeriods    TimetablePeriod[]
  periodSubstitutions PeriodSubstitution[]
  periodAttendances   PeriodAttendance[]
}

model Campus {
  id           String   @id @default(uuid())
  schoolId     String
  name         String
  code         String
  address      String?
  contactPhone String?
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([schoolId])
}

model SchoolDomain {
  id         String    @id @default(uuid())
  schoolId   String
  domain     String    @unique
  verifiedAt DateTime?
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  priceMinor        Int            @default(0)
  currency          String         @default("INR")
  billingInterval   String         @default("YEARLY") // MONTHLY, YEARLY
  studentLimit      Int            @default(500)
  staffLimit        Int            @default(50)
  storageLimitBytes BigInt         @default(10737418240) // 10 GB
  featureFlags      String         @default("{}") // JSON string
  trialDays         Int            @default(30)
  graceDays         Int            @default(15)
  subscriptions     Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  schoolId    String
  planId      String
  status      String           @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, EXPIRED, CANCELLED
  startsAt    DateTime         @default(now())
  endsAt      DateTime
  providerRef String?
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ----------------------------------------------------
// 2. USER, IDENTITY & RBAC
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  username     String?  @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  tokenVersion Int      @default(0) // bumped on logout / password change to revoke issued tokens
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserSchoolMembership[]
  guardians     Guardian[]
  staff         Staff[]
  students      Student[]
  notifications Notification[]
  reminders           Reminder[]
  assignedTasks       Task[]                    @relation("AssignedToUser")
  createdTasks        Task[]                    @relation("CreatedByUser")
  submittedFeedbacks  Feedback[]                @relation("SubmitterUser")
  respondedFeedbacks  Feedback[]                @relation("ResponderUser")
  circularAcknowledgements CircularAcknowledgement[]
  passwordResetTokens PasswordResetToken[]
  notificationLogs    NotificationDeliveryLog[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model UserSchoolMembership {
  id          String   @id @default(uuid())
  userId      String
  schoolId    String
  status      String   @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  defaultRole String   // PLATFORM_OWNER, SCHOOL_ADMIN, OFFICE, PRINCIPAL, CLASS_TEACHER, SUBJECT_TEACHER, PARENT, STUDENT
  createdAt   DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]
  scopes MembershipScope[]

  @@unique([userId, schoolId])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  memberships MembershipRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. student.read, attendance.mark
  name        String
  module      String
  roles       RolePermission[]
}

model MembershipRole {
  id           String               @id @default(uuid())
  membershipId String
  roleId       String
  membership   UserSchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model MembershipScope {
  id           String               @id @default(uuid())
  membershipId String
  classId      String?
  sectionId    String?
  subjectId    String?
  branchId     String?
  membership   UserSchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 3. ACADEMIC STRUCTURE
// ----------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("ACTIVE") // ACTIVE, CLOSED

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms            AcademicTerm[]
  enrollments      Enrollment[]
  timetableEntries TimetableEntry[]
  exams            Exam[]
  feePlans         FeePlan[]

  aiExamTests      AiExamTest[]
  timetablePeriods TimetablePeriod[]
  @@index([schoolId])
}

model AcademicTerm {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String   // e.g. "Term 1", "Semester 1"
  code           String   // e.g. "T1"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, code])
  @@index([schoolId])
  @@index([academicYearId])
}

model Class {
  id         String   @id @default(uuid())
  schoolId   String
  name       String   // e.g. "Grade 10"
  code       String   // e.g. "G10"
  orderIndex Int      @default(0)
  programId  String?  // outcome-based education: the program (stream/degree) this class belongs to

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program            Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  sections           Section[]
  enrollments        Enrollment[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]
  examSubjects       ExamSubject[]
  feePlans           FeePlan[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]
  circulars          Circular[]

  aiExamTests        AiExamTest[]
  @@index([schoolId])
}

model Section {
  id       String @id @default(uuid())
  schoolId String
  classId  String
  name     String // e.g. "Section A"
  room     String?
  capacity Int    @default(40)

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  attendanceSessions  AttendanceSession[]
  timetableEntries    TimetableEntry[]
  assignments         Assignment[]
  teachingDiaries     TeachingDiaryEntry[]
  circulars           Circular[]

  aiExamTests         AiExamTest[]
  periodSubstitutions PeriodSubstitution[]
  periodAttendances   PeriodAttendance[]
  @@index([schoolId])
  @@index([classId])
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  name     String // e.g. "Mathematics"
  code     String // e.g. "MATH101"
  type     String @default("CORE") // CORE, ELECTIVE

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assignments        Assignment[]
  examSubjects       ExamSubject[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]
  courseMaterials    CourseMaterial[]
  courseOutcomes     CourseOutcome[]
  questions          Question[]
  attainmentRules    AttainmentRule[]
  internalSchemes    InternalMarkScheme[]
  quizzes            Quiz[]

  aiExamTests        AiExamTest[]
  periodSubstitutions PeriodSubstitution[]
  periodAttendances   PeriodAttendance[]
  @@index([schoolId])
}

model ClassSubject {
  id         String  @id @default(uuid())
  schoolId   String
  classId    String
  subjectId  String
  isOptional Boolean @default(false)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
}

// ----------------------------------------------------
// 4. STUDENTS, GUARDIANS & ENROLLMENT
// ----------------------------------------------------

model Student {
  id               String   @id @default(uuid())
  schoolId         String
  userId           String?  // Linked student login account
  admissionNo      String
  firstName        String
  lastName         String
  dob              DateTime
  gender           String   // MALE, FEMALE, OTHER
  bloodGroup       String?
  address          String?
  emergencyContact String?
  status           String   @default("ACTIVE") // ACTIVE, WITHDRAWN, ALUMNI
  joinedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  studentGuardians  StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  marks             Mark[]
  invoices          Invoice[]
  leaveRequests     LeaveRequest[]
  documents         StudentDocument[]
  questionMarks     QuestionMark[]
  internalManualMarks InternalManualMark[]
  quizAttempts      QuizAttempt[]

  aiExamAssignments AiExamAssignee[]
  aiExamSubmissions AiExamSubmission[]
  aiExamPlans       AiExamImprovementPlan[]
  periodAttendanceRecords PeriodAttendanceRecord[]
  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

model Guardian {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String?  // Linked parent account
  name        String
  relation    String   // FATHER, MOTHER, LEGAL_GUARDIAN
  phone       String
  email       String?
  occupation  String?

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
  @@index([userId])
}

model StudentGuardian {
  id              String  @id @default(uuid())
  studentId       String
  guardianId      String
  relationship    String
  isPrimary       Boolean @default(false)
  canAccessPortal Boolean @default(true)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
}

model Enrollment {
  id             String @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  rollNo         Int?
  status         String @default("ACTIVE") // ACTIVE, PROMOTED, TRANSFERRED

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classId, sectionId])
}

model StudentDocument {
  id           String   @id @default(uuid())
  schoolId     String
  studentId    String
  title        String
  documentType String   // BIRTH_CERTIFICATE, TRANSFER_CERTIFICATE, PREVIOUS_MARKSHEET, MEDICAL_RECORD, OTHER
  fileUrl      String
  fileType     String?
  uploadedAt   DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
}

// ----------------------------------------------------
// 5. STAFF & TEACHER ASSIGNMENTS
// ----------------------------------------------------

model Staff {
  id           String    @id @default(uuid())
  schoolId     String
  userId       String?
  employeeNo   String
  firstName    String
  lastName     String
  designation  String
  department   String
  phone        String
  email        String
  joiningDate  DateTime
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assignments        Assignment[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]
  periodSubstitutions PeriodSubstitution[]
  periodAttendances   PeriodAttendance[]

  @@unique([schoolId, employeeNo])
  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

model TeacherAssignment {
  id             String  @id @default(uuid())
  schoolId       String
  staffId        String
  classId        String
  sectionId      String
  subjectId      String?
  isClassTeacher Boolean @default(false)
  source         String? // null = assigned by an admin; TIMETABLE = created from the class timetable

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([schoolId])
  @@index([staffId])
  @@index([classId, sectionId])
  @@index([subjectId])
}

// ----------------------------------------------------
// 6. ATTENDANCE & TIMETABLE
// ----------------------------------------------------

model AttendanceSession {
  id          String   @id @default(uuid())
  schoolId    String
  sectionId   String
  date        DateTime
  sessionType String   @default("DAILY") // DAILY, PERIOD
  periodNo    Int?
  status      String   @default("SUBMITTED") // DRAFT, SUBMITTED, LOCKED
  createdBy   String?
  createdAt   DateTime @default(now())

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([schoolId, sectionId, date, sessionType])
  @@index([schoolId])
  @@index([sectionId])
  @@index([date])
}

model AttendanceRecord {
  id        String  @id @default(uuid())
  sessionId String
  studentId String
  status    String  // PRESENT, ABSENT, LATE, HALF_DAY, EXCUSED
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
}

model TimetableEntry {
  id             String @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  staffId        String
  dayOfWeek      Int    // 1 = Monday ... 7 = Sunday
  periodNumber   Int    // 1 to 8
  startTime      String // "09:00"
  endTime        String // "09:45"
  room           String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, sectionId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([sectionId])
  @@index([staffId])
  @@index([dayOfWeek])
}

// ----------------------------------------------------
// 6b. BELL SCHEDULE, DAILY SUBSTITUTIONS & PERIOD ATTENDANCE
// ----------------------------------------------------

/// The periods of each school day (the timeline). Set by the office.
model TimetablePeriod {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  dayOfWeek      Int      // 1 = Monday ... 7 = Sunday
  periodNumber   Int
  startTime      String   // "09:00"
  endTime        String   // "09:45"
  label          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, dayOfWeek, periodNumber])
  @@index([schoolId])
}

/// A one-day change to a section's timetable: another teacher takes the period on that date.
model PeriodSubstitution {
  id              String   @id @default(uuid())
  schoolId        String
  sectionId       String
  date            DateTime @db.Date
  periodNumber    Int
  staffId         String   // teacher taking the period that day
  subjectId       String?
  originalStaffId String?  // timetable teacher at the time of the change
  reason          String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([sectionId, date, periodNumber])
  @@index([schoolId])
  @@index([staffId, date])
}

/// Attendance taken for one period of one section on one date.
model PeriodAttendance {
  id           String   @id @default(uuid())
  schoolId     String
  sectionId    String
  date         DateTime @db.Date
  periodNumber Int
  subjectId    String?
  staffId      String   // teacher who took the period
  markedById   String?  // user who last saved it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section                  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  staff   Staff                    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  records PeriodAttendanceRecord[]

  @@unique([sectionId, date, periodNumber])
  @@index([schoolId])
  @@index([staffId, date])
}

model PeriodAttendanceRecord {
  id                 String  @id @default(uuid())
  periodAttendanceId String
  studentId          String
  status             String  // PRESENT, ABSENT, LATE, EXCUSED
  remarks            String?

  periodAttendance PeriodAttendance @relation(fields: [periodAttendanceId], references: [id], onDelete: Cascade)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([periodAttendanceId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------
// 7. ASSIGNMENTS & HOMEWORK
// ----------------------------------------------------

model Assignment {
  id          String   @id @default(uuid())
  schoolId    String
  classId     String
  sectionId   String
  subjectId   String
  teacherId   String
  title       String
  description String
  issueDate   DateTime @default(now())
  dueDate     DateTime
  maxMarks    Int      @default(100)
  status      String   @default("ACTIVE") // ACTIVE, CLOSED

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Staff        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]
  questionPaper QuestionPaper?

  @@index([schoolId])
  @@index([classId, sectionId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([dueDate])
}

model Submission {
  id            String    @id @default(uuid())
  assignmentId  String
  studentId     String
  submittedAt   DateTime  @default(now())
  status        String    @default("SUBMITTED") // SUBMITTED, REVIEWED, LATE
  fileUrl       String?
  notes         String?
  marksObtained Int?
  feedback      String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

// ----------------------------------------------------
// 8. EXAMINATIONS & MARKS
// ----------------------------------------------------

model Exam {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String   // e.g. "Term 1 Mid-Term Examination"
  term           String   // e.g. "TERM_1"
  startDate      DateTime
  endDate        DateTime
  status         String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, MODERATION, APPROVED, PUBLISHED

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects     ExamSubject[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([status])
}

model ExamSubject {
  id        String   @id @default(uuid())
  examId    String
  classId   String
  subjectId String
  examDate  DateTime
  maxMarks  Int      @default(100)
  passMarks Int      @default(35)
  assessmentType String @default("INTERNAL") // INTERNAL (continuous assessment) or EXTERNAL (end-semester / board)

  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionPaper QuestionPaper?
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([examId, classId, subjectId])
  @@index([examId])
  @@index([classId])
  @@index([subjectId])
}

model Mark {
  id            String  @id @default(uuid())
  examSubjectId String
  studentId     String
  marksObtained Int?
  isAbsent      Boolean @default(false)
  remarks       String?

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([examSubjectId])
  @@index([studentId])
}

// ----------------------------------------------------
// 9. FEES & PAYMENTS
// ----------------------------------------------------

model FeeHead {
  id          String  @id @default(uuid())
  schoolId    String
  name        String  // Tuition Fee, Lab Fee, Transport Fee
  code        String
  description String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model FeePlan {
  id               String @id @default(uuid())
  schoolId         String
  academicYearId   String
  classId          String
  name             String // "Standard Annual Grade 10 Plan"
  totalAmountMinor Int    // Amount in paise/cents (e.g. 5000000 = Rs. 50,000)
  currency         String @default("INR")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
}

model Invoice {
  id              String   @id @default(uuid())
  schoolId        String
  studentId       String
  invoiceNo       String
  title           String   // "Term 1 Tuition Fee"
  category        String   @default("SCHOOL") // SCHOOL, HOSTEL, TRANSPORT
  amountMinor     Int
  paidAmountMinor Int      @default(0)
  dueAmountMinor  Int
  dueDate         DateTime
  status          String   @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, CANCELLED
  createdAt       DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([schoolId, invoiceNo])
  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model Payment {
  id             String   @id @default(uuid())
  schoolId       String
  invoiceId      String
  amountMinor    Int
  method         String   @default("ONLINE") // CASH, ONLINE, CHEQUE, BANK_TRANSFER
  status         String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  transactionRef String?
  receiptNo      String
  notes          String?
  createdAt      DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptNo])
  @@index([schoolId])
  @@index([invoiceId])
  @@index([createdAt])
}

// ----------------------------------------------------
// 10. LEAVE, ANNOUNCEMENTS, AUDIT LOG
// ----------------------------------------------------

model LeaveRequest {
  id              String   @id @default(uuid())
  schoolId        String
  studentId       String
  applicantName   String
  leaveType       String   @default("MEDICAL") // MEDICAL, CASUAL, FAMILY, OTHER
  startDate       DateTime
  endDate         DateTime
  reason          String
  supportingDocUrl String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionRemarks String?
  decidedBy       String?
  createdAt       DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
}

model Announcement {
  id          String   @id @default(uuid())
  schoolId    String
  title       String
  content     String
  targetRole  String   @default("ALL") // ALL, TEACHER, PARENT, STUDENT
  priority    String   @default("NORMAL") // NORMAL, URGENT
  startsAt    DateTime @default(now())
  expiresAt   DateTime?
  attachments String?  // JSON
  publishedAt DateTime @default(now())
  authorName  String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([targetRole])
  @@index([publishedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?
  actorId   String
  actorName String?
  action    String   // ATTENDANCE_MARKED, MARKS_PUBLISHED, INVOICE_PAID, TENANT_CREATED
  entity    String   // Student, Attendance, Invoice, School
  entityId  String?
  details   String?  // JSON string
  timestamp DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([actorId])
  @@index([action])
  @@index([timestamp])
}

model Notification {
  id        String    @id @default(uuid())
  schoolId  String
  userId    String
  title     String
  body      String
  channel   String    @default("IN_APP") // IN_APP, PUSH, SMS, EMAIL
  status    String    @default("UNREAD") // UNREAD, READ, ARCHIVED
  priority  String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  eventKey  String?
  dedupKey  String?
  metadata  String?   // JSON string
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([status])
  @@index([dedupKey])
}

// ----------------------------------------------------
// 11. ACADEMIC SUITE (OBE, COURSE DIARY & REPOSITORY)
// ----------------------------------------------------

model LessonPlan {
  id                 String   @id @default(uuid())
  schoolId           String
  classId            String
  subjectId          String
  teacherId          String
  unitNumber         Int      // e.g. Unit 1, Unit 2
  unitTitle          String
  topic              String
  learningObjectives String?
  plannedHours       Int      @default(3)
  conductedHours     Int      @default(0)
  status             String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId, subjectId])
  @@index([teacherId])
}

model TeachingDiaryEntry {
  id           String   @id @default(uuid())
  schoolId     String
  classId      String
  sectionId    String
  subjectId    String
  teacherId    String
  date         DateTime
  periodNumber Int
  topicTaught  String
  methodology  String   @default("LECTURE") // LECTURE, LAB, FLIPPED_CLASS, GROUP_DISCUSSION
  remarks      String?
  createdAt    DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([classId, sectionId])
  @@index([teacherId])
  @@index([date])
}

model CourseMaterial {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  title       String
  unitNumber  Int      @default(1)
  fileType    String   // PDF, SLIDES, DOC, VIDEO_LINK
  fileUrl     String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([subjectId])
}

model CourseOutcome {
  id               String   @id @default(uuid())
  schoolId         String
  subjectId        String
  code             String   // e.g. "CO1", "CO2"
  description      String
  bloomLevel       String   // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE
  targetAttainment Int      @default(70)
  orderIndex       Int      @default(0)
  // Indirect attainment (0-3) from the course exit survey; null when no survey was run.
  indirectLevel    Float?
  createdAt        DateTime @default(now())

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  poMappings CoPoMapping[]
  questions  Question[]

  @@unique([subjectId, code])
  @@index([schoolId])
  @@index([subjectId])
}

// ----------------------------------------------------
// 12. REMINDERS, TASKS, FEEDBACKS & CIRCULARS
// ----------------------------------------------------

model Reminder {
  id          String    @id @default(uuid())
  schoolId    String
  userId      String
  title       String
  description String?
  category    String    // FEE_DUE, ATTENDANCE_LOW, TASK_DUE, EXAM_MARK_ENTRY, SYLLABUS_PENDING, CUSTOM
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  remindAt    DateTime  @default(now())
  status      String    @default("PENDING") // PENDING, SENT, COMPLETED, DISMISSED
  entityType  String?   // Invoice, ExamSubject, Task, Attendance
  entityId    String?
  dedupKey    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([dedupKey])
}

model Task {
  id           String    @id @default(uuid())
  schoolId     String
  assignedToId String
  createdById  String?
  title        String
  description  String?
  category     String    // ATTENDANCE, MARK_ENTRY, SYLLABUS, FEE_PAYMENT, LEAVE_APPROVAL, CIRCULAR, ASSIGNMENT, GENERAL
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE, CANCELLED
  dueDate      DateTime?
  completedAt  DateTime?
  actionUrl    String?
  metadata     String?   // JSON
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedTo User   @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
}

model Feedback {
  id              String    @id @default(uuid())
  schoolId        String
  submitterId     String
  targetType      String    @default("GENERAL") // TEACHER, SCHOOL, FACILITY, TRANSPORT, STUDENT, ACADEMIC
  targetId        String?
  targetName      String?
  category        String    // ACADEMIC, BEHAVIOR, INFRASTRUCTURE, TRANSPORT, GENERAL, COMPLAINT, SUGGESTION
  title           String
  content         String
  rating          Int?
  isAnonymous     Boolean   @default(false)
  status          String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, RESOLVED, DISMISSED
  response        String?
  respondedById   String?
  respondedByName String?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submitter   User   @relation("SubmitterUser", fields: [submitterId], references: [id], onDelete: Cascade)
  respondedBy User?  @relation("ResponderUser", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([submitterId])
  @@index([status])
}

model Circular {
  id             String    @id @default(uuid())
  schoolId       String
  circularNumber String
  title          String
  content        String
  senderType     String    // CLASS_TEACHER, OFFICE_EMPLOYEE, PRINCIPAL, SCHOOL_ADMIN
  senderId       String
  senderName     String
  targetAudience String    // ALL, CLASS_STUDENTS, CLASS_PARENTS, ALL_TEACHERS, ALL_PARENTS, OFFICE_STAFF
  classId        String?
  sectionId      String?
  priority       String    @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  requiresAck    Boolean   @default(false)
  ackDeadline    DateTime?
  attachments    String?   // JSON
  status         String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school           School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class            Class?                    @relation(fields: [classId], references: [id], onDelete: SetNull)
  section          Section?                  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  acknowledgements CircularAcknowledgement[]

  @@index([schoolId])
  @@index([targetAudience])
  @@index([status])
}

model CircularAcknowledgement {
  id             String   @id @default(uuid())
  circularId     String
  userId         String
  userName       String
  userRole       String
  acknowledgedAt DateTime @default(now())
  remarks        String?

  circular Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circularId, userId])
  @@index([circularId])
  @@index([userId])
}

model NotificationDeliveryLog {
  id             String    @id @default(uuid())
  schoolId       String
  notificationId String?
  reminderId     String?
  recipientId    String
  channel        String    @default("IN_APP") // IN_APP, PUSH, SMS, EMAIL
  status         String    // SUCCESS, FAILED, RETRIED
  attemptCount   Int       @default(1)
  errorDetails   String?
  executedAt     DateTime  @default(now())
  triggerContext String?   // JSON with entityType, entityId, triggerCondition, timezone

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([schoolId, recipientId])
  @@index([status])
  @@index([executedAt])
}

// ----------------------------------------------------
// 12. OUTCOME-BASED EDUCATION (PROGRAM OUTCOMES, CO-PO MAPPING, QUESTION-WISE ASSESSMENT)
// ----------------------------------------------------

/// A program (degree, stream or grade band) whose outcomes the courses map to.
model Program {
  id          String   @id @default(uuid())
  schoolId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  outcomes ProgramOutcome[]
  classes  Class[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/// Program Outcome (PO), Program Specific Outcome (PSO) or Program Educational Objective (PEO).
model ProgramOutcome {
  id          String  @id @default(uuid())
  schoolId    String
  programId   String
  type        String // PO, PSO, PEO
  code        String // e.g. "PO1", "PSO2"
  title       String?
  description String
  orderIndex  Int     @default(0)

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program    Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  coMappings CoPoMapping[]

  @@unique([programId, code])
  @@index([schoolId])
  @@index([programId])
}

/// Correlation of a course outcome with a program outcome: 1 = low, 2 = medium, 3 = high.
model CoPoMapping {
  id               String @id @default(uuid())
  courseOutcomeId  String
  programOutcomeId String
  strength         Int

  courseOutcome  CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  programOutcome ProgramOutcome @relation(fields: [programOutcomeId], references: [id], onDelete: Cascade)

  @@unique([courseOutcomeId, programOutcomeId])
  @@index([programOutcomeId])
}

/// How attainment levels are computed. subjectId = null is the school-wide default.
model AttainmentRule {
  id                   String   @id @default(uuid())
  schoolId             String
  subjectId            String?
  studentTargetPercent Float    @default(60) // a student attains a CO when scoring at least this % on its questions
  level1Percent        Float    @default(40) // % of students attaining the CO needed for level 1
  level2Percent        Float    @default(50)
  level3Percent        Float    @default(60)
  internalWeight       Float    @default(40) // weights inside direct attainment (renormalised if one side has no data)
  externalWeight       Float    @default(60)
  directWeight         Float    @default(80) // direct vs indirect (course exit survey) in the final attainment
  indirectWeight       Float    @default(20)
  targetLevel          Float    @default(2)  // expected level; outcomes below it are flagged
  updatedAt            DateTime @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subjectId])
  @@index([schoolId])
}

/// Question bank entry tagged with its course outcome and Bloom's taxonomy level.
model Question {
  id              String   @id @default(uuid())
  schoolId        String
  subjectId       String
  courseOutcomeId String?
  text            String
  marks           Float
  bloomLevel      String   // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE
  type            String   @default("DESCRIPTIVE") // DESCRIPTIVE, SHORT_ANSWER, MCQ
  options         Json?    // MCQ: array of option strings
  correctOption   Int?     // MCQ: index into options
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject       Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseOutcome CourseOutcome?      @relation(fields: [courseOutcomeId], references: [id], onDelete: SetNull)
  paperItems    QuestionPaperItem[]
  quizItems     QuizQuestion[]

  @@index([schoolId])
  @@index([subjectId])
  @@index([courseOutcomeId])
}

/// A question paper for one exam subject or one assignment.
model QuestionPaper {
  id              String   @id @default(uuid())
  schoolId        String
  examSubjectId   String?  @unique
  assignmentId    String?  @unique
  title           String
  durationMinutes Int?
  instructions    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examSubject ExamSubject?           @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  assignment  Assignment?            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sections    QuestionPaperSection[]

  @@index([schoolId])
}

model QuestionPaperSection {
  id           String  @id @default(uuid())
  paperId      String
  title        String
  instructions String?
  orderIndex   Int     @default(0)

  paper QuestionPaper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  items QuestionPaperItem[]

  @@index([paperId])
}

model QuestionPaperItem {
  id         String @id @default(uuid())
  sectionId  String
  questionId String
  label      String // e.g. "1a"
  marks      Float  // may differ from the bank default
  orderIndex Int    @default(0)

  section      QuestionPaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question     Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)
  marksEntries QuestionMark[]

  @@index([sectionId])
  @@index([questionId])
}

/// Marks a student scored on one question of a paper.
model QuestionMark {
  id            String   @id @default(uuid())
  paperItemId   String
  studentId     String
  marksObtained Float
  updatedAt     DateTime @updatedAt

  paperItem QuestionPaperItem @relation(fields: [paperItemId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([paperItemId, studentId])
  @@index([studentId])
}

// ----------------------------------------------------
// 13. INTERNAL ASSESSMENT (INTERNAL MARK RULES) & ONLINE QUIZZES
// ----------------------------------------------------

/// How a subject's internal mark is built from exams, assignments, attendance and manual marks.
model InternalMarkScheme {
  id         String   @id @default(uuid())
  schoolId   String
  subjectId  String
  classId    String?  // null = applies to every class studying the subject
  name       String
  passPercent Float   @default(40) // students below this % of the internal mark are flagged
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject    Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  components InternalMarkComponent[]

  @@index([schoolId])
  @@index([subjectId])
}

model InternalMarkComponent {
  id         String   @id @default(uuid())
  schemeId   String
  label      String   // e.g. "Class tests", "Attendance"
  type       String   // EXAM, ASSIGNMENT, ATTENDANCE, MANUAL
  weight     Float    // marks this component contributes to the internal mark
  bestOf     Int?     // EXAM / ASSIGNMENT: count only the best N of the selected assessments
  sourceIds  String[] // EXAM: exam subject ids; ASSIGNMENT: assignment ids
  orderIndex Int      @default(0)

  scheme      InternalMarkScheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  manualMarks InternalManualMark[]

  @@index([schemeId])
}

/// Marks entered directly for a MANUAL component (out of the component's weight).
model InternalManualMark {
  id          String   @id @default(uuid())
  componentId String
  studentId   String
  marks       Float
  updatedAt   DateTime @updatedAt

  component InternalMarkComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  student   Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([componentId, studentId])
  @@index([studentId])
}

/// Online multiple-choice quiz built from MCQ questions in the bank; graded automatically.
model Quiz {
  id              String    @id @default(uuid())
  schoolId        String
  subjectId       String
  classId         String
  sectionId       String?   // null = every section of the class
  title           String
  instructions    String?
  durationMinutes Int?
  opensAt         DateTime?
  closesAt        DateTime?
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  showAnswers     Boolean   @default(true)    // reveal correct answers after submitting
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([schoolId])
  @@index([subjectId])
  @@index([classId])
}

model QuizQuestion {
  id         String @id @default(uuid())
  quizId     String
  questionId String
  marks      Float
  orderIndex Int    @default(0)

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([quizId, questionId])
  @@index([questionId])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  answers     Json?     // { questionId: chosen option index }
  score       Float?
  maxScore    Float
  late        Boolean   @default(false)

  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId])
}

// ============================================================================
// AI Examination & Performance Analyzer (Classes 10-12)
// ============================================================================

/// Module settings per school.
model AiExamSettings {
  id               String   @id @default(uuid())
  schoolId         String   @unique
  autoEvaluate     Boolean  @default(true) // queue AI evaluation as soon as a test is submitted
  reviewConfidence Float    @default(0.6)  // AI evaluations below this confidence go to teacher review
  allowVoice       Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A test created by a teacher for one class (optionally one section) and subject.
model AiExamTest {
  id                 String    @id @default(uuid())
  schoolId           String
  academicYearId     String
  classId            String
  sectionId          String?   // null = every section of the class
  subjectId          String
  title              String
  description        String?
  chapter            String?
  topics             String[]
  instructions       String?
  totalMarks         Float     @default(0) // kept equal to the sum of question marks
  durationMinutes    Int?
  startsAt           DateTime?
  endsAt             DateTime?
  status             String    @default("DRAFT") // DRAFT, PUBLISHED, CLOSED, ARCHIVED (scheduled/active derive from times)
  assignMode         String    @default("CLASS") // CLASS, SECTION, STUDENTS
  autoSubmit         Boolean   @default(true)
  publishedAt        DateTime?
  resultsPublishedAt DateTime?
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions    AiExamQuestion[]
  assignees    AiExamAssignee[]
  submissions  AiExamSubmission[]

  @@index([schoolId, classId, subjectId])
  @@index([schoolId, status])
}

/// MCQ, SHORT, LONG, FILL_BLANK, TRUE_FALSE or NUMERICAL question with its answer key.
model AiExamQuestion {
  id                String   @id @default(uuid())
  testId            String
  orderIndex        Int      @default(0)
  type              String
  text              String
  imageUrl          String?
  marks             Float
  chapter           String?
  topic             String?
  difficulty        String   @default("MEDIUM") // EASY, MEDIUM, HARD
  options           Json?    // MCQ option strings
  correctOption     Int?     // MCQ index; TRUE_FALSE: 1 = true, 0 = false
  answerKey         String?  // model answer / expected value
  acceptableAnswers String[]
  keywords          String[]
  concepts          String[] // essential concepts
  explanation       String?
  partialCredit     String?  // partial-credit rules in words
  tolerance         Float?   // NUMERICAL: allowed absolute difference
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  test    AiExamTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  rubric  AiExamRubricCriterion[]
  answers AiExamAnswer[]

  @@index([testId])
}

/// One marking criterion; the criteria of a question add up to its marks.
model AiExamRubricCriterion {
  id          String @id @default(uuid())
  questionId  String
  description String
  marks       Float
  orderIndex  Int    @default(0)

  question AiExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// Students a test is assigned to when assignMode = STUDENTS.
model AiExamAssignee {
  id        String @id @default(uuid())
  testId    String
  studentId String

  test    AiExamTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([studentId])
}

/// One attempt per student per test.
model AiExamSubmission {
  id               String    @id @default(uuid())
  schoolId         String
  testId           String
  studentId        String
  status           String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  startedAt        DateTime  @default(now())
  deadline         DateTime?
  submittedAt      DateTime?
  autoSubmitted    Boolean   @default(false)
  late             Boolean   @default(false)
  evaluationStatus String    @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING, PROCESSING, EVALUATED, FAILED, REVIEW
  score            Float?
  maxScore         Float     @default(0)
  lastSavedAt      DateTime?

  test    AiExamTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers AiExamAnswer[]

  @@unique([testId, studentId])
  @@index([schoolId, studentId])
}

/// A student's answer; typed and voice answers share this structure.
model AiExamAnswer {
  id           String   @id @default(uuid())
  submissionId String
  questionId   String
  text         String   @default("")
  choice       Int?     // MCQ option index / TRUE_FALSE 1 or 0
  inputMethod  String   @default("TYPED") // TYPED, VOICE, MIXED
  updatedAt    DateTime @updatedAt

  submission AiExamSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AiExamQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluation AiExamEvaluation?

  @@unique([submissionId, questionId])
  @@index([questionId])
}

/// Evaluation of one answer. AI marks and teacher marks are stored separately.
model AiExamEvaluation {
  id             String    @id @default(uuid())
  answerId       String    @unique
  status         String    @default("PENDING") // PENDING, PROCESSING, EVALUATED, FAILED, REVIEW
  method         String?   // AUTO (answer key), AI, MOCK (development evaluator), TEACHER
  maxMarks       Float
  aiMarks        Float?
  teacherMarks   Float?
  finalMarks     Float?
  feedback       Json?     // validated structured feedback
  criteria       Json?     // per-rubric-criterion marks
  confidence     Float?
  reviewReasons  String[]
  overrideReason String?
  reviewedById   String?
  reviewedAt     DateTime?
  provider       String?
  model          String?
  attempts       Int       @default(0)
  lastError      String?
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  answer AiExamAnswer          @relation(fields: [answerId], references: [id], onDelete: Cascade)
  events AiExamEvaluationEvent[]

  @@index([status])
}

/// History of every evaluation result, failure and teacher override.
model AiExamEvaluationEvent {
  id           String   @id @default(uuid())
  evaluationId String
  kind         String   // AUTO_RESULT, AI_RESULT, AI_FAILED, TEACHER_OVERRIDE, REQUEUED
  marks        Float?
  details      Json?
  actorId      String?
  createdAt    DateTime @default(now())

  evaluation AiExamEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

/// Latest generated improvement plan for a student (cached to avoid repeated AI calls).
model AiExamImprovementPlan {
  id        String   @id @default(uuid())
  schoolId  String
  studentId String
  source    String   // RULES or AI
  plan      Json
  basedOn   Int      // number of evaluated tests used
  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}
