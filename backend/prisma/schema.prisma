datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. TENANT & SUBSCRIPTION
// ----------------------------------------------------

model School {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  slug         String   @unique
  status       String   @default("ACTIVE") // PENDING, TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELLED, CLOSED
  timezone     String   @default("Asia/Kolkata")
  locale       String   @default("en_IN")
  currency     String   @default("INR")
  logoUrl      String?
  address      String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains             SchoolDomain[]
  subscriptions       Subscription[]
  memberships         UserSchoolMembership[]
  academicYears       AcademicYear[]
  classes             Class[]
  sections            Section[]
  students            Student[]
  guardians           Guardian[]
  staff               Staff[]
  subjects            Subject[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions  AttendanceSession[]
  timetableEntries    TimetableEntry[]
  assignments         Assignment[]
  exams               Exam[]
  feeHeads            FeeHead[]
  feePlans            FeePlan[]
  invoices            Invoice[]
  payments            Payment[]
  leaveRequests       LeaveRequest[]
  announcements       Announcement[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  reminders           Reminder[]
  tasks               Task[]
  feedbacks           Feedback[]
  circulars           Circular[]
}

model SchoolDomain {
  id         String    @id @default(uuid())
  schoolId   String
  domain     String    @unique
  verifiedAt DateTime?
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  priceMinor        Int            @default(0)
  currency          String         @default("INR")
  billingInterval   String         @default("YEARLY") // MONTHLY, YEARLY
  studentLimit      Int            @default(500)
  staffLimit        Int            @default(50)
  storageLimitBytes BigInt         @default(10737418240) // 10 GB
  featureFlags      String         @default("{}") // JSON string
  trialDays         Int            @default(30)
  graceDays         Int            @default(15)
  subscriptions     Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  schoolId    String
  planId      String
  status      String           @default("ACTIVE") // ACTIVE, TRIAL, PAST_DUE, EXPIRED, CANCELLED
  startsAt    DateTime         @default(now())
  endsAt      DateTime
  providerRef String?
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
}

// ----------------------------------------------------
// 2. USER, IDENTITY & RBAC
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  username     String?  @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  status       String   @default("ACTIVE") // ACTIVE, SUSPENDED
  tokenVersion Int      @default(0) // bumped on logout / password change to revoke issued tokens
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserSchoolMembership[]
  guardians     Guardian[]
  staff         Staff[]
  students      Student[]
  notifications Notification[]
  reminders           Reminder[]
  assignedTasks       Task[]                    @relation("AssignedToUser")
  createdTasks        Task[]                    @relation("CreatedByUser")
  submittedFeedbacks  Feedback[]                @relation("SubmitterUser")
  respondedFeedbacks  Feedback[]                @relation("ResponderUser")
  circularAcknowledgements CircularAcknowledgement[]
}

model UserSchoolMembership {
  id          String   @id @default(uuid())
  userId      String
  schoolId    String
  status      String   @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  defaultRole String   // PLATFORM_OWNER, SCHOOL_ADMIN, OFFICE, PRINCIPAL, CLASS_TEACHER, SUBJECT_TEACHER, PARENT, STUDENT
  createdAt   DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]
  scopes MembershipScope[]

  @@unique([userId, schoolId])
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  memberships MembershipRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. student.read, attendance.mark
  name        String
  module      String
  roles       RolePermission[]
}

model MembershipRole {
  id           String               @id @default(uuid())
  membershipId String
  roleId       String
  membership   UserSchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model MembershipScope {
  id           String               @id @default(uuid())
  membershipId String
  classId      String?
  sectionId    String?
  subjectId    String?
  branchId     String?
  membership   UserSchoolMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 3. ACADEMIC STRUCTURE
// ----------------------------------------------------

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  name      String   // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  status    String   @default("ACTIVE") // ACTIVE, CLOSED

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  timetableEntries TimetableEntry[]
  exams            Exam[]
  feePlans         FeePlan[]
}

model Class {
  id         String   @id @default(uuid())
  schoolId   String
  name       String   // e.g. "Grade 10"
  code       String   // e.g. "G10"
  orderIndex Int      @default(0)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections           Section[]
  enrollments        Enrollment[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  assignments        Assignment[]
  examSubjects       ExamSubject[]
  feePlans           FeePlan[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]
  circulars          Circular[]
}

model Section {
  id       String @id @default(uuid())
  schoolId String
  classId  String
  name     String // e.g. "Section A"
  room     String?
  capacity Int    @default(40)

  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  attendanceSessions  AttendanceSession[]
  timetableEntries    TimetableEntry[]
  assignments         Assignment[]
  teachingDiaries     TeachingDiaryEntry[]
  circulars           Circular[]
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  name     String // e.g. "Mathematics"
  code     String // e.g. "MATH101"
  type     String @default("CORE") // CORE, ELECTIVE

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assignments        Assignment[]
  examSubjects       ExamSubject[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]
  courseMaterials    CourseMaterial[]
}

model ClassSubject {
  id         String  @id @default(uuid())
  schoolId   String
  classId    String
  subjectId  String
  isOptional Boolean @default(false)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

// ----------------------------------------------------
// 4. STUDENTS, GUARDIANS & ENROLLMENT
// ----------------------------------------------------

model Student {
  id               String   @id @default(uuid())
  schoolId         String
  userId           String?  // Linked student login account
  admissionNo      String
  firstName        String
  lastName         String
  dob              DateTime
  gender           String   // MALE, FEMALE, OTHER
  bloodGroup       String?
  address          String?
  emergencyContact String?
  status           String   @default("ACTIVE") // ACTIVE, WITHDRAWN, ALUMNI
  joinedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id])
  studentGuardians  StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  marks             Mark[]
  invoices          Invoice[]
  leaveRequests     LeaveRequest[]

  @@unique([schoolId, admissionNo])
}

model Guardian {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String?  // Linked parent account
  name        String
  relation    String   // FATHER, MOTHER, LEGAL_GUARDIAN
  phone       String
  email       String?
  occupation  String?

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id])
  students StudentGuardian[]
}

model StudentGuardian {
  id              String  @id @default(uuid())
  studentId       String
  guardianId      String
  relationship    String
  isPrimary       Boolean @default(false)
  canAccessPortal Boolean @default(true)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

model Enrollment {
  id             String @id @default(uuid())
  schoolId       String
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  rollNo         Int?
  status         String @default("ACTIVE") // ACTIVE, PROMOTED, TRANSFERRED

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
}

// ----------------------------------------------------
// 5. STAFF & TEACHER ASSIGNMENTS
// ----------------------------------------------------

model Staff {
  id           String    @id @default(uuid())
  schoolId     String
  userId       String?
  employeeNo   String
  firstName    String
  lastName     String
  designation  String
  department   String
  phone        String
  email        String
  joiningDate  DateTime
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assignments        Assignment[]
  lessonPlans        LessonPlan[]
  teachingDiaries    TeachingDiaryEntry[]

  @@unique([schoolId, employeeNo])
}

model TeacherAssignment {
  id             String  @id @default(uuid())
  schoolId       String
  staffId        String
  classId        String
  sectionId      String
  subjectId      String?
  isClassTeacher Boolean @default(false)

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
}

// ----------------------------------------------------
// 6. ATTENDANCE & TIMETABLE
// ----------------------------------------------------

model AttendanceSession {
  id          String   @id @default(uuid())
  schoolId    String
  sectionId   String
  date        DateTime
  sessionType String   @default("DAILY") // DAILY, PERIOD
  periodNo    Int?
  status      String   @default("SUBMITTED") // DRAFT, SUBMITTED, LOCKED
  createdBy   String?
  createdAt   DateTime @default(now())

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([schoolId, sectionId, date, sessionType])
}

model AttendanceRecord {
  id        String  @id @default(uuid())
  sessionId String
  studentId String
  status    String  // PRESENT, ABSENT, LATE, HALF_DAY, EXCUSED
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model TimetableEntry {
  id             String @id @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String
  subjectId      String
  staffId        String
  dayOfWeek      Int    // 1 = Monday ... 7 = Sunday
  periodNumber   Int    // 1 to 8
  startTime      String // "09:00"
  endTime        String // "09:45"
  room           String?

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, sectionId, dayOfWeek, periodNumber])
}

// ----------------------------------------------------
// 7. ASSIGNMENTS & HOMEWORK
// ----------------------------------------------------

model Assignment {
  id          String   @id @default(uuid())
  schoolId    String
  classId     String
  sectionId   String
  subjectId   String
  teacherId   String
  title       String
  description String
  issueDate   DateTime @default(now())
  dueDate     DateTime
  maxMarks    Int      @default(100)
  status      String   @default("ACTIVE") // ACTIVE, CLOSED

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Staff        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id            String    @id @default(uuid())
  assignmentId  String
  studentId     String
  submittedAt   DateTime  @default(now())
  status        String    @default("SUBMITTED") // SUBMITTED, REVIEWED, LATE
  fileUrl       String?
  notes         String?
  marksObtained Int?
  feedback      String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

// ----------------------------------------------------
// 8. EXAMINATIONS & MARKS
// ----------------------------------------------------

model Exam {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String   // e.g. "Term 1 Mid-Term Examination"
  term           String   // e.g. "TERM_1"
  startDate      DateTime
  endDate        DateTime
  status         String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, MODERATION, APPROVED, PUBLISHED

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects     ExamSubject[]
}

model ExamSubject {
  id        String   @id @default(uuid())
  examId    String
  classId   String
  subjectId String
  examDate  DateTime
  maxMarks  Int      @default(100)
  passMarks Int      @default(35)

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks   Mark[]

  @@unique([examId, classId, subjectId])
}

model Mark {
  id            String  @id @default(uuid())
  examSubjectId String
  studentId     String
  marksObtained Int?
  isAbsent      Boolean @default(false)
  remarks       String?

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
}

// ----------------------------------------------------
// 9. FEES & PAYMENTS
// ----------------------------------------------------

model FeeHead {
  id          String  @id @default(uuid())
  schoolId    String
  name        String  // Tuition Fee, Lab Fee, Transport Fee
  code        String
  description String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FeePlan {
  id               String @id @default(uuid())
  schoolId         String
  academicYearId   String
  classId          String
  name             String // "Standard Annual Grade 10 Plan"
  totalAmountMinor Int    // Amount in paise/cents (e.g. 5000000 = Rs. 50,000)
  currency         String @default("INR")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String   @id @default(uuid())
  schoolId        String
  studentId       String
  invoiceNo       String
  title           String   // "Term 1 Tuition Fee"
  category        String   @default("SCHOOL") // SCHOOL, HOSTEL, TRANSPORT
  amountMinor     Int
  paidAmountMinor Int      @default(0)
  dueAmountMinor  Int
  dueDate         DateTime
  status          String   @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE, CANCELLED
  createdAt       DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([schoolId, invoiceNo])
}

model Payment {
  id             String   @id @default(uuid())
  schoolId       String
  invoiceId      String
  amountMinor    Int
  method         String   @default("ONLINE") // CASH, ONLINE, CHEQUE, BANK_TRANSFER
  status         String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  transactionRef String?
  receiptNo      String
  notes          String?
  createdAt      DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([schoolId, receiptNo])
}

// ----------------------------------------------------
// 10. LEAVE, ANNOUNCEMENTS, AUDIT LOG
// ----------------------------------------------------

model LeaveRequest {
  id              String   @id @default(uuid())
  schoolId        String
  studentId       String
  applicantName   String
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionRemarks String?
  decidedBy       String?
  createdAt       DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(uuid())
  schoolId    String
  title       String
  content     String
  targetRole  String   @default("ALL") // ALL, TEACHER, PARENT, STUDENT
  priority    String   @default("NORMAL") // NORMAL, URGENT
  publishedAt DateTime @default(now())
  authorName  String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?
  actorId   String
  actorName String?
  action    String   // ATTENDANCE_MARKED, MARKS_PUBLISHED, INVOICE_PAID, TENANT_CREATED
  entity    String   // Student, Attendance, Invoice, School
  entityId  String?
  details   String?  // JSON string
  timestamp DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  schoolId  String
  userId    String
  title     String
  body      String
  channel   String    @default("IN_APP") // IN_APP, PUSH, SMS, EMAIL
  status    String    @default("UNREAD") // UNREAD, READ, ARCHIVED
  eventKey  String?
  metadata  String?   // JSON string
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 11. LINWAYS ACADEMIC SUITE (OBE, COURSE DIARY & REPOSITORY)
// ----------------------------------------------------

model LessonPlan {
  id                 String   @id @default(uuid())
  schoolId           String
  classId            String
  subjectId          String
  teacherId          String
  unitNumber         Int      // e.g. Unit 1, Unit 2
  unitTitle          String
  topic              String
  learningObjectives String?
  plannedHours       Int      @default(3)
  conductedHours     Int      @default(0)
  status             String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeachingDiaryEntry {
  id           String   @id @default(uuid())
  schoolId     String
  classId      String
  sectionId    String
  subjectId    String
  teacherId    String
  date         DateTime
  periodNumber Int
  topicTaught  String
  methodology  String   @default("LECTURE") // LECTURE, LAB, FLIPPED_CLASS, GROUP_DISCUSSION
  remarks      String?
  createdAt    DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Staff   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model CourseMaterial {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  title       String
  unitNumber  Int      @default(1)
  fileType    String   // PDF, SLIDES, DOC, VIDEO_LINK
  fileUrl     String
  uploadedBy  String?
  createdAt   DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 12. REMINDERS, TASKS, FEEDBACKS & CIRCULARS
// ----------------------------------------------------

model Reminder {
  id          String    @id @default(uuid())
  schoolId    String
  userId      String
  title       String
  description String?
  category    String    // FEE_DUE, ATTENDANCE_LOW, TASK_DUE, EXAM_MARK_ENTRY, SYLLABUS_PENDING, CUSTOM
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  remindAt    DateTime  @default(now())
  status      String    @default("PENDING") // PENDING, SENT, COMPLETED, DISMISSED
  entityType  String?   // Invoice, ExamSubject, Task, Attendance
  entityId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(uuid())
  schoolId     String
  assignedToId String
  createdById  String?
  title        String
  description  String?
  category     String    // ATTENDANCE, MARK_ENTRY, SYLLABUS, FEE_PAYMENT, LEAVE_APPROVAL, CIRCULAR, ASSIGNMENT, GENERAL
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE, CANCELLED
  dueDate      DateTime?
  completedAt  DateTime?
  actionUrl    String?
  metadata     String?   // JSON
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignedTo User   @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy  User?  @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
}

model Feedback {
  id              String    @id @default(uuid())
  schoolId        String
  submitterId     String
  targetType      String    @default("GENERAL") // TEACHER, SCHOOL, FACILITY, TRANSPORT, STUDENT, ACADEMIC
  targetId        String?
  targetName      String?
  category        String    // ACADEMIC, BEHAVIOR, INFRASTRUCTURE, TRANSPORT, GENERAL, COMPLAINT, SUGGESTION
  title           String
  content         String
  rating          Int?
  isAnonymous     Boolean   @default(false)
  status          String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, RESOLVED, DISMISSED
  response        String?
  respondedById   String?
  respondedByName String?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submitter   User   @relation("SubmitterUser", fields: [submitterId], references: [id], onDelete: Cascade)
  respondedBy User?  @relation("ResponderUser", fields: [respondedById], references: [id], onDelete: SetNull)
}

model Circular {
  id             String    @id @default(uuid())
  schoolId       String
  circularNumber String
  title          String
  content        String
  senderType     String    // CLASS_TEACHER, OFFICE_EMPLOYEE, PRINCIPAL, SCHOOL_ADMIN
  senderId       String
  senderName     String
  targetAudience String    // ALL, CLASS_STUDENTS, CLASS_PARENTS, ALL_TEACHERS, ALL_PARENTS, OFFICE_STAFF
  classId        String?
  sectionId      String?
  priority       String    @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  requiresAck    Boolean   @default(false)
  ackDeadline    DateTime?
  attachments    String?   // JSON
  status         String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  publishedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school           School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class            Class?                    @relation(fields: [classId], references: [id], onDelete: SetNull)
  section          Section?                  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  acknowledgements CircularAcknowledgement[]
}

model CircularAcknowledgement {
  id             String   @id @default(uuid())
  circularId     String
  userId         String
  userName       String
  userRole       String
  acknowledgedAt DateTime @default(now())
  remarks        String?

  circular Circular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circularId, userId])
}

