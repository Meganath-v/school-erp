# ==============================================================================
# Multi-Tenant School ERP & Linways AMS - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONNECTIONS
# ------------------------------------------------------------------------------
# In your Supabase Dashboard:
# 1. Navigate to: Project Settings -> Database -> Connection string
# 2. For connection pooling (port 6543, recommended for web requests & serverless):
#    Choose 'Transaction' or 'Session' mode, copy the URI, and replace [YOUR-PASSWORD].
# 3. For direct connection (port 5432, required for Prisma migrations / db push):
#    Choose 'Session' or 'Direct' mode, copy the URI, and replace [YOUR-PASSWORD].

# Transaction Pooler (Used by NestJS / PrismaClient during runtime)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Used by Prisma CLI for migrations & push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase API Access (For Supabase Storage / Supabase Auth)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 2. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=school_erp_secure_jwt_secret_key_2026_antigravity
JWT_ACCESS_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 4. REDIS (OPTIONAL FOR DEV / PRODUCTION CACHING)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. LINWAYS AMS ACADEMIC SYSTEM DEFAULTS
# ------------------------------------------------------------------------------
ATTENDANCE_CONDONATION_THRESHOLD=75
OBE_SYLLABUS_DEFAULT_HOURS=40
DEFAULT_ACADEMIC_YEAR=2026-2027

# ------------------------------------------------------------------------------
# 6. STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_MAX_SIZE_BYTES=10485760
